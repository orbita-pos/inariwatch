{
  "name": "@inariwatch/node-forensic",
  "version": "0.1.0-alpha.0",
  "description": "Forensic frame capture for @inariwatch/capture — locals + closures + receiver at throw time. Uses the ForensicVM fork when present, falls back to inspector.Session on stock Node.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fallback": {
      "types": "./dist/fallback-inspector.d.ts",
      "import": "./dist/fallback-inspector.js",
      "default": "./dist/fallback-inspector.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "keywords": [
    "inariwatch",
    "capture",
    "forensics",
    "frame-locals",
    "inspector"
  ],
  "author": "Jesus Bernal <info@jesusbr.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbita-pos/inariwatch.git",
    "directory": "capture-forensic"
  },
  "license": "MIT",
  "peerDependencies": {
    "@inariwatch/capture": ">=0.9.0"
  },
  "peerDependenciesMeta": {
    "@inariwatch/capture": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inariwatch/capture": "file:../capture",
    "@types/node": "^25.5.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
