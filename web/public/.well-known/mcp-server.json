{
  "name": "inariwatch",
  "version": "1.0.0",
  "description": "AI-powered DevOps monitoring with bug reproduction, autonomous remediation, and cryptographic verification",
  "vendor": "InariWatch",
  "homepage": "https://inariwatch.com",
  "documentation": "https://app.inariwatch.com/docs#mcp-overview",
  "endpoint": "https://mcp.inariwatch.com",
  "protocol": "streamable-http",
  "tools": [
    "query_alerts", "get_status", "get_uptime", "get_build_logs",
    "get_substrate_context", "get_root_cause", "assess_risk", "get_postmortem",
    "search_community_fixes", "trigger_fix", "rollback_vercel", "silence_alert",
    "submit_feedback", "run_check", "ask_inari", "get_error_trends",
    "create_uptime_monitor", "run_health_check",
    "reproduce_bug", "simulate_fix", "verify_remediation"
  ],
  "resources": [
    "inariwatch://alerts/critical",
    "inariwatch://alerts/recent",
    "inariwatch://status/overview",
    "inariwatch://remediations/active"
  ],
  "prompts": [
    "diagnose", "status-report", "fix-this", "post-deploy-check",
    "weekly-summary", "production-health-check", "daily-report"
  ],
  "auth": {
    "type": "oauth2.1",
    "scopes": ["read", "write", "execute"],
    "discovery": "https://mcp.inariwatch.com/api/mcp/.well-known/oauth-authorization-server"
  },
  "tier": "freemium",
  "plans": {
    "free": { "tools": 8, "rate_limit": "100/hour" },
    "pro": { "tools": 18, "rate_limit": "1000/hour" },
    "enterprise": { "tools": 21, "rate_limit": "10000/hour" }
  },
  "sla": {
    "uptime": "99.9%",
    "p95_latency_ms": 500
  }
}
