# =============================================================================
# .env.production.template
# =============================================================================
#
# Template for the production secrets the Next.js app needs on Hetzner.
# COMMITTED — with placeholder values only. Never put real secrets here.
#
# Workflow to wire up real secrets:
#
#   1. Copy this template to a gitignored local-only file:
#        cp web/.env.production.template web/.env.production.local
#
#   2. Fill in REAL values from your .env.vercel-pull (keep that file local
#      too, never commit). Replace every `REPLACE_ME` below.
#
#   3. Encrypt to .env.sops.yaml — this is the file Kamal reads at deploy:
#        sops -e web/.env.production.local > web/.env.sops.yaml
#
#   4. Commit the encrypted file:
#        git add web/.env.sops.yaml && git commit -m "chore: update prod secrets"
#
#   5. Delete the plaintext local:
#        rm web/.env.production.local
#
# Editing later — sops interactive mode re-encrypts on save:
#   sops web/.env.sops.yaml
#
# Decrypting to inspect (local only):
#   sops -d web/.env.sops.yaml
#
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL: "REPLACE_ME"                    # Neon pooled connection string
NEXTAUTH_SECRET: "REPLACE_ME"                 # `openssl rand -base64 32`
ENCRYPTION_KEY: "REPLACE_ME"                  # 32-byte key for project integrations at rest
CRON_SECRET: "REPLACE_ME"                     # must match the value on the Hetzner Go scheduler

# ── OAuth providers ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID: "REPLACE_ME"
GOOGLE_CLIENT_SECRET: "REPLACE_ME"
GITHUB_CLIENT_ID: "REPLACE_ME"
GITHUB_CLIENT_SECRET: "REPLACE_ME"

# ── Slack bot ────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID: "REPLACE_ME"
SLACK_CLIENT_SECRET: "REPLACE_ME"
SLACK_SIGNING_SECRET: "REPLACE_ME"

# ── Telegram bot ─────────────────────────────────────────────────────────────
TELEGRAM_WEBHOOK_SECRET: "REPLACE_ME"

# ── AI (platform-funded keys) ────────────────────────────────────────────────
PLATFORM_AI_KEY: "REPLACE_ME"                 # OpenAI key for GPT-4o/5.x
PLATFORM_ANTHROPIC_KEY: "REPLACE_ME"          # Claude key for Sonnet/Opus calls

# ── Redis (Upstash for Vercel-compat routes, Hetzner-local via URL) ──────────
