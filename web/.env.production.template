# ── Email + Web Push ─────────────────────────────────────────────────────────
RESEND_API_KEY: "REPLACE_ME"
VAPID_PRIVATE_KEY: "REPLACE_ME"
VAPID_EMAIL: "mailto:hello@inariwatch.com"

# ── Feature flags ────────────────────────────────────────────────────────────
PREVIEW_FIX_ORGS: "*"                          # or comma-separated UUIDs
PREVIEW_FIX_USERS: ""                          # optional, UUID allowlist
REPLAY_V2_ORGS: "*"                            # same pattern
