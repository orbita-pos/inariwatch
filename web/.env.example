# =============================================================================
# InariWatch — Environment Variables
# Copy this file to .env.local and fill in your values.
#
# Quick start:
#   cp .env.example .env.local
#   # Required: DATABASE_URL, NEXTAUTH_SECRET, ENCRYPTION_KEY
#   # Everything else is optional — features are disabled if not set
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE (required)
# Postgres-compatible. Recommended: Neon free tier at https://neon.tech
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"


# -----------------------------------------------------------------------------
# AUTH (required)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# NEXTAUTH_URL = your full public URL, no trailing slash
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Subdomain routing (production only)
# app.yourdomain.com  = dashboard
# yourdomain.com      = marketing / landing
# NEXT_PUBLIC_ROOT_DOMAIN="yourdomain.com"


# -----------------------------------------------------------------------------
# ENCRYPTION (required)
# AES-256-GCM key for storing integration secrets in the database.
# Generate with: openssl rand -hex 32
# WARNING: Changing this key will make existing encrypted values unreadable.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=""


# -----------------------------------------------------------------------------
# CRON (required in production)
# Authenticates Vercel cron calls to /api/cron/*
# Generate with: openssl rand -hex 16
# Set the same value in vercel.json under cron job headers.
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# FREE TIER AI — Platform-funded key for basic alert analysis
#
# OpenAI API key that funds ALL AI features for users without their own key.
# All features (analysis, chat, remediation, postmortem, risk) work with this key.
# Uses GPT-4o-mini for analysis, GPT-5.4 for code fixes. $100/day budget cap.
# Leave empty to require BYOK for all AI features (not recommended).
# -----------------------------------------------------------------------------
PLATFORM_AI_KEY=""

# -----------------------------------------------------------------------------
# EMAIL — SMTP (optional, enables email notifications + invites)
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com  PORT=587  SECURE=false
#   SMTP_PASS = App Password (myaccount.google.com/apppasswords)
#
# Resend (recommended for production — https://resend.com):
#   SMTP_HOST=smtp.resend.com  PORT=465  SECURE=true
#   SMTP_USER=resend  SMTP_PASS=re_your_api_key
#
# Postmark, Mailgun, SendGrid also work with SMTP credentials.
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="InariWatch <alerts@yourdomain.com>"

# Email rate limits (per user per period)
EMAIL_RATE_LIMIT_HOURLY="10"
EMAIL_RATE_LIMIT_DAILY="50"
EMAIL_RATE_LIMIT_GLOBAL_DAILY="1000"

# AWS SES bounce/complaint webhook secret (optional)
# SES_WEBHOOK_SECRET=""


# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS — Web Push / VAPID (optional)
# Generate keys with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_ prefix required for the public key (used in browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@yourdomain.com"


# -----------------------------------------------------------------------------
# OAUTH — Social Login (optional)
# Callback URL pattern: {NEXTAUTH_URL}/api/auth/callback/{provider}
#
# GitHub:  github.com/settings/developers → New OAuth App
# Google:  console.cloud.google.com → Credentials → OAuth 2.0
# GitLab:  gitlab.com/-/user_settings/applications
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""


# -----------------------------------------------------------------------------
# ADMIN (optional)
# Email address of the super-admin user. Grants access to /admin panel
# and to the blog editor at /admin/blog.
# -----------------------------------------------------------------------------
ADMIN_EMAIL="you@example.com"


# -----------------------------------------------------------------------------
# STRIPE (optional — Stripe is not required, the app runs fully free)
# Only needed if you re-enable paid plans.
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRO_PRICE_ID="price_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."


# -----------------------------------------------------------------------------
# RESEND (optional — alternative to SMTP, recommended for production)
# Get your API key at https://resend.com
# -----------------------------------------------------------------------------
# RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# TELEGRAM BOT (optional — enables Telegram bot notifications)
# Create a bot via @BotFather, set the webhook secret in bot settings
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# EXPO (optional — enables mobile push notifications + Expo poller)
# Get token at https://expo.dev/accounts/[account]/settings/access-tokens
# -----------------------------------------------------------------------------
# EXPO_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# SLACK BOT (optional — enables full Slack bot with OAuth)
# Create a Slack App at api.slack.com/apps → Basic Information
# -----------------------------------------------------------------------------
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""


# -----------------------------------------------------------------------------
# EAP / CORTEX (optional — enables cryptographic verification of AI fixes)
# Points to a running Cortex server. If not set, EAP gates pass without verification.
# -----------------------------------------------------------------------------
# EAP_SERVER_URL="http://localhost:9301"

# -----------------------------------------------------------------------------
# STAGING SERVER (optional — enables ephemeral staging verification)
# Points to the InariWatch staging orchestrator. If not set, staging gate
# uses GitHub Actions E2E fallback.
# -----------------------------------------------------------------------------
# STAGING_SERVER_URL="https://api.staging.inariwatch.com"
# STAGING_API_SECRET="<64-char hex secret>"
# CONTAINER_AGENT_ENABLED="false"  # Enable container agent for remediation (requires STAGING_SERVER_URL)


# -----------------------------------------------------------------------------
# CONTAINER POOL — Fase 2b warm pre-hydrated containers on inari-staging
#
# When CONTAINER_POOL_ENABLED=true AND STAGING_SERVER_URL+STAGING_API_SECRET
# are set, the worker tries POST /pool/checkout on the Go server before
# cold-spawning a container. Miss (404) or any error falls back to cold
# spawn transparently. The /api/cron/pool-rehydrate route keeps the pool
# warm for the top 50 most-active projects in the last 7 days.
#
# Worker reads CONTAINER_POOL_ENABLED from its own env (not this file).
# CONTAINER_POOL_MAX and CONTAINER_POOL_PER_PROJECT_MAX live on the Go
# server (/opt/inari-staging/.env) — setting them here has no effect.
# They are documented here so operators can see the full shape of the
# feature in one place.
#
# Kill switch: set CONTAINER_POOL_ENABLED=false (or unset). Worker
# resumes existing cold-spawn path on the next remediation. No restart,
# no redeploy required — env is re-read per invocation.
# -----------------------------------------------------------------------------
# CONTAINER_POOL_ENABLED="false"
# CONTAINER_POOL_MAX="2"               # Go server env — CX22 default
# CONTAINER_POOL_PER_PROJECT_MAX="1"   # Go server env — CX22 default


# -----------------------------------------------------------------------------
# APP URL (production)
# Used for Slack OAuth callbacks and cron fan-out. Falls back to VERCEL_URL.
# -----------------------------------------------------------------------------
# APP_URL="https://app.inariwatch.com"


# -----------------------------------------------------------------------------
# REPLAY V2 (optional — synced frontend + backend session replay)
#
# Block-based storage on Cloudflare R2 (S3-compatible). Each session is split
# into 30-second gzipped blocks under {org_id}/{session_id}/block_NNNN.json.gz.
#
# Setup:
#   1. Create an R2 bucket at https://dash.cloudflare.com/?to=/:account/r2
#   2. Generate an API token (Object Read & Write) for the bucket
#   3. Set the env vars below
#   4. Enable per-org via REPLAY_V2_ORGS (UUIDs comma-separated, or "*")
#
# Without these vars, the /api/replay/* endpoints return 503 even if the
# feature flag is on.
# -----------------------------------------------------------------------------
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="inariwatch-replays"
# REPLAY_V2_ORGS=""              # "org_uuid_a,org_uuid_b" or "*"


# -----------------------------------------------------------------------------
# GRADERS API (Fase 1 — Telemetry Foundation)
#
# Enables runGoldenDataset() in web/lib/ai/graders.ts. When false (default)
# the function throws GradersDisabledError so nothing runs against OpenAI
# accidentally. Flip to "true" only when you want to score a dataset — the
# call burns OpenAI tokens and is meant to be an on-demand ops action.
# Kill switch: set back to "false" (or unset). No redeploy required.
# -----------------------------------------------------------------------------
# GRADERS_ENABLED="false"


# -----------------------------------------------------------------------------
# PRE-PUSH STRICT HOOKS (Fase 4 Part A)
#
# When "true", the Hetzner worker runs tsc/npm test/npm run lint inside
# the remediation container AFTER the agent calls submit_fix and BEFORE
# the web app pushes to GitHub. Any hook failure is fed back into the
# agent loop as a synthetic tool_result so the agent retries apply_patch
# with the error context — the push never happens until the fix is green.
#
# Detection is automatic: tsc runs only when tsconfig.json exists, npm test
# only when package.json has a test script, lint only when it has a lint
# script. Each hook logs one row to ai_usage_logs with feature
# 'prepush-tsc|test|lint' so /admin/remediation-lab can compute pass rate.
#
# Flag is read per remediation, so toggling off takes effect immediately
# (no redeploy). Default: false (preserves current behavior exactly).
# -----------------------------------------------------------------------------
# PREPUSH_TESTS_ENABLED="false"


# -----------------------------------------------------------------------------
# CI WEBHOOK MODE (Fase 4 Part B)
#
# When "true", remediation sessions subscribe to Redis pub/sub on
# remediation:<sessionId>:ci and the GitHub check_run.completed webhook at
# /api/webhooks/github-check-run/[integrationId] publishes a wake signal
# as soon as CI finishes. The listener still re-queries GitHub's API to
# confirm the authoritative conclusion — the webhook payload is just a
# fast wake, never trusted on its own.
#
# When Redis is unavailable, the listener returns immediately and the
# remediation falls back to the existing 15s polling loop. Safe to leave
# on even during Redis outages.
#
# GitHub setup (only required when enabling this flag in production):
#   1. In your project's webhook config, add a second webhook URL at
#      https://<host>/api/webhooks/github-check-run/<integrationId> with
#      the SAME secret as the primary GitHub integration webhook.
#   2. Subscribe to "Check runs" events only — alert-creating webhooks
#      stay on the primary /api/webhooks/github endpoint.
#
# When PREPUSH_TESTS_ENABLED is also "true", Part C kicks in: a CI failure
# after a green pre-push is treated as flake and re-pushed up to 3 times
# with 30s / 2m / 5m backoff before falling through to the existing
# regenerate-the-fix path.
#
# Default: false. Kill switch: set back to "false" (or unset).
# -----------------------------------------------------------------------------
# CI_WEBHOOK_MODE="false"


# -----------------------------------------------------------------------------
# REMEDIATION MODEL ROUTING (Fase 3)
#
# Umbrella flag for the Fase 3 model-routing work. When "true":
#
#   • Worker container-agent splits the loop into explore / fix phases.
#     OpenAI provider gets gpt-5-mini (low reasoning) during exploration,
#     swaps to gpt-5.4 (medium → high reasoning) once it calls apply_patch
#     or a think tool that names a specific file to fix. On the transition
#     the worker compacts messages[] and resets the Responses API thread.
#
#   • Vercel fallback container-agent swaps the same model pair for
#     OpenAI only (no compaction — that path is capped at 15 turns).
#
#   • Both web and worker AI clients install an undici keep-alive agent
#     (connections: 32, pipelining: 1, keepAliveTimeout: 30s). This reuses
#     TLS sockets to OpenAI/Anthropic so multi-turn remediations avoid
#     re-handshaking on every call (~80-150ms per turn).
#
# Non-OpenAI providers (Claude, Grok, DeepSeek, Gemini, Groq) keep whatever
# models the caller passed — BYOK behavior is unchanged.
#
# Default is "false" (unset). Kill switch: set back to "false" (or unset).
# No redeploy required — env is re-read per job, and the keep-alive agent
# is a pure performance optimization invisible to callers.
# -----------------------------------------------------------------------------
# REMEDIATION_MODEL_ROUTING="false"


# -----------------------------------------------------------------------------
# TESTING (never set in production)
# -----------------------------------------------------------------------------
# PLAYWRIGHT_BASE_URL="http://localhost:3000"
# TEST_USER_EMAIL="test@example.com"
# TEST_USER_PASSWORD="testpassword123"
