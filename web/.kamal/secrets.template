#!/usr/bin/env bash
# .kamal/secrets — loaded by Kamal on every `kamal deploy` / `kamal setup`.
#
# This is a TEMPLATE. Copy to .kamal/secrets and fill in the registry
# password yourself (the rest comes from sops).
#
#   cp .kamal/secrets.template .kamal/secrets
#   chmod 600 .kamal/secrets
#
# .kamal/secrets is gitignored. .kamal/secrets.template is committed.

set -euo pipefail

# Registry — GHCR. Username is your GitHub handle / org. Password is a
# personal access token with `write:packages` scope.
#   gh auth token  # if you're logged into gh CLI
export KAMAL_REGISTRY_USERNAME="${KAMAL_REGISTRY_USERNAME:-orbita-pos}"
export KAMAL_REGISTRY_PASSWORD="${KAMAL_REGISTRY_PASSWORD:-$(gh auth token 2>/dev/null || echo FAIL_SET_KAMAL_REGISTRY_PASSWORD)}"

# Everything else comes from the sops-encrypted file. `sops -d` prints the
# decrypted YAML on stdout; we eval it as shell exports. Requires `sops` and
# the age private key at ~/.config/sops/age/keys.txt.
if [ -f .env.sops.yaml ]; then
  # shellcheck disable=SC2046
  eval "$(sops -d --output-type dotenv .env.sops.yaml | sed -e 's/^/export /')"
else
  echo "warning: .env.sops.yaml missing — Kamal will deploy without app secrets" >&2
fi
