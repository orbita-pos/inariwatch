{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@inariwatch/ai-router": [
        "../packages/ai-router/src/index.ts"
      ],
      "@inariwatch/ai-router/eslint": [
        "../packages/ai-router/src/lockdown/eslint-rule.js"
      ],
      "@inariwatch/code-intel-extractor-ts": [
        "../packages/code-intel-extractor-ts/src/index.ts"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../packages/ai-router/src/**/*.ts",
    "../packages/code-intel-extractor-ts/src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
