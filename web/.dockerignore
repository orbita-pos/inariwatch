# Keep the build context small — anything not needed by `next build` or
# the runtime stage is excluded. This matters for build speed AND for not
# leaking secrets into image layers.

# ── Build output + caches ─────────────────────────────────────────────────
.next
out
node_modules
.turbo
.vercel

# ── Env files (secrets live in Kamal + sops, never in the image) ──────────
.env
.env.*
!.env.example
.env.sops.yaml

# ── VCS + editor metadata ─────────────────────────────────────────────────
.git
.gitignore
.github
.vscode
.idea
*.swp
.DS_Store

# ── Tests + fixtures (not needed at runtime) ──────────────────────────────
__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
playwright.config.ts
playwright-report
test-results

# ── Internal docs (operator-only runbooks) ────────────────────────────────
docs/

# ── Scripts (one-off tooling, run locally) ────────────────────────────────
scripts/

# ── Logs + local state ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Misc dev artifacts ────────────────────────────────────────────────────
coverage
.nyc_output
README.md
CHANGELOG.md
