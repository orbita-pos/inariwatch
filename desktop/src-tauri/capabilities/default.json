{
  "identifier": "default",
  "description": "Default capability for the main window and Inari Live",
  "windows": ["main", "inari", "inari-settings", "inari-live-dock"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "dialog:default",
    "dialog:allow-open"
  ]
}
