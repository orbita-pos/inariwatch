# Visual Report demo — copy to .env.local and fill in your values.
#
# Get the project token + id from the InariWatch dashboard:
#   1. Sign in to http://localhost:3000
#   2. Open or create a project
#   3. Settings → API Tokens → "Create token (public)"
#   4. Copy the iwk_pub_v1_… and the project UUID

NEXT_PUBLIC_INARIWATCH_TOKEN=iwk_pub_v1_REPLACE_ME
NEXT_PUBLIC_INARIWATCH_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Set to https://app.inariwatch.com to send to production. Use localhost:3000
# when the web app is running locally (`cd web && npm run dev`).
NEXT_PUBLIC_INARIWATCH_HOST=http://localhost:3000
