{
  "name": "@inariwatch/capture-fleet",
  "version": "0.1.0-alpha.0",
  "description": "Fleet bloom filter integration for @inariwatch/capture. Lets the SDK answer 'has anyone else hit this fingerprint?' in <1ms without a server round-trip. Spec: CAPTURE_V2_IMPLEMENTATION.md Q5.4.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --no-warnings dist/__test__/*.test.js"
  },
  "keywords": [
    "inariwatch",
    "capture",
    "bloom",
    "fleet"
  ],
  "author": "Jesus Bernal <info@jesusbr.com>",
  "license": "MIT",
  "peerDependencies": {
    "@inariwatch/capture": ">=0.10.0"
  },
  "devDependencies": {
    "@inariwatch/capture": "file:../capture",
    "@types/node": "^25.5.0",
    "typescript": "^5.5.0"
  }
}
