# /opt/inari-relay/.env — production template. NEVER commit the real file.
#
# Generate values once and store in sops-encrypted secrets repo (same
# pattern as inari-staging .env per project_hetzner_hardening.md).

# Listen address. 0.0.0.0:9402 binds public; Caddy fronts it with TLS.
RELAY_ADDR=0.0.0.0:9402

# 32-byte hex shared secret for web ↔ relay /dispatch + /admin/connections.
# Generate: openssl rand -hex 32
RELAY_DISPATCH_SECRET=

# Seed for HS256 JWT signing key. Web derives the same key by hashing
# this seed with SHA-256("inariwatch-relay-jwt:" || seed). Rotate with
# care: existing JWTs become invalid (sidecars reconnect with a fresh
# token in <30s).
INARI_LIVE_RELAY_JWT_KEY=
