{
  "name": "@inariwatch/capture-feedback",
  "version": "0.1.0",
  "description": "User feedback widget for @inariwatch/capture — floating button + modal with screenshot, zero external deps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "feedback",
    "widget",
    "inariwatch",
    "bug-report",
    "screenshot"
  ],
  "author": "Jesus Bernal <info@jesusbr.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbita-pos/inariwatch-capture.git",
    "directory": "packages/capture-feedback"
  },
  "homepage": "https://inariwatch.com/docs/feedback",
  "bugs": {
    "url": "https://github.com/orbita-pos/inariwatch-capture/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@inariwatch/capture": "^0.7.0"
  },
  "devDependencies": {
    "@inariwatch/capture": "file:../capture",
    "@types/node": "^25.5.0",
    "typescript": "^5.5.0"
  }
}
