{
  "name": "@inariwatch/capture-performance",
  "version": "0.1.0",
  "description": "Web Vitals performance integration for @inariwatch/capture — LCP, INP, CLS, FCP, TTFB with zero config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "web-vitals",
    "performance",
    "inariwatch",
    "lcp",
    "inp",
    "cls"
  ],
  "author": "Jesus Bernal <info@jesusbr.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbita-pos/inariwatch-capture.git",
    "directory": "packages/capture-performance"
  },
  "homepage": "https://inariwatch.com/docs/performance",
  "bugs": {
    "url": "https://github.com/orbita-pos/inariwatch-capture/issues"
  },
  "license": "MIT",
  "dependencies": {
    "web-vitals": "^4.2.0"
  },
  "peerDependencies": {
    "@inariwatch/capture": "^0.7.0"
  },
  "devDependencies": {
    "@inariwatch/capture": "file:../capture",
    "@types/node": "^25.5.0",
    "typescript": "^5.5.0"
  }
}
